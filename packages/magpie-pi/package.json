{
  "name": "magpie-pi",
  "version": "0.3.1",
  "description": "Magpie community plugin integration for Pi",
  "license": "UNLICENSED",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extension/",
    "vendor/",
    "bin/",
    "extraction.json",
    "README.md",
    "README.zh-CN.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arklee/magpie-pi.git",
    "directory": "packages/magpie-pi"
  },
  "type": "module",
  "exports": {
    "./embed": {
      "types": "./extension/embed.d.ts",
      "default": "./extension/embed.mjs"
    },
    "./extension/*": "./extension/*",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "~1.6.0",
    "@earendil-works/pi-coding-agent": "~1.6.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "verify:extraction": "node scripts/extraction.mjs",
    "test:provider": "bun test tests/provider.test.ts",
    "check": "npm run verify:extraction && npm run build && npm test && npm run test:provider && npm run typecheck && go vet ./... && go test ./...",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm exec --yes --package typescript@7.0.2 -- tsc --noEmit --allowJs --skipLibCheck --module nodenext --moduleResolution nodenext --target es2022 extension/index.ts"
  }
}
